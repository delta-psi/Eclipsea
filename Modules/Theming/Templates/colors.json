    "surface_container_highest": "{{ colors.surface_container_highest.default | saturate: 12 | lighten: 6 | get_hex }}",
    "surface_variant": "{{ colors.surface_variant.default | saturate: 15 | get_hex }}"
  },

  "accents": {
    "primary": "{{ colors.primary.default | saturate: 30 | get_hex }}",
