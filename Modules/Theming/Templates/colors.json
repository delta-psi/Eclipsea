{
  "mode": "{{ mode }}",

  "surfaces": {
    "surface": "{{ colors.surface.default | saturate: 20 | darken: 5 | get_hex }}",
    "surface_dim": "{{ colors.surface_dim.default | saturate: 20 | darken: 5 | get_hex }}",
    "surface_bright": "{{ colors.surface_bright.default | saturate: 15 | get_hex }}",
    "surface_container_lowest": "{{ colors.surface_container_lowest.default | saturate: 25 | darken: 8 | get_hex }}",
    "surface_container_low": "{{ colors.surface_container_low.default | saturate: 20 | darken: 4 | get_hex }}",
    "surface_container": "{{ colors.surface_container.default | saturate: 18 | get_hex }}",
