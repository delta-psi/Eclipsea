    "on_primary_container": "{{ colors.on_primary_container.default.hex }}",

    "secondary": "{{ colors.secondary.default | saturate: 25 | get_hex }}",
    "on_secondary": "{{ colors.on_secondary.default.hex }}",
    "secondary_container": "{{ colors.secondary_container.default | saturate: 20 | get_hex }}",
    "on_secondary_container": "{{ colors.on_secondary_container.default.hex }}",

    "tertiary": "{{ colors.tertiary.default | saturate: 35 | get_hex }}",
    "on_tertiary": "{{ colors.on_tertiary.default.hex }}",
    "tertiary_container": "{{ colors.tertiary_container.default | saturate: 30 | get_hex }}",
    "on_tertiary_container": "{{ colors.on_tertiary_container.default.hex }}"
  },

  "text": {
    "on_surface": "{{ colors.on_surface.default.hex }}",
    "on_surface_variant": "{{ colors.on_surface_variant.default.hex }}",
    "inverse_on_surface": "{{ colors.inverse_on_surface.default.hex }}"
  },

  "states_and_outlines": {
    "outline": "{{ colors.outline.default | saturate: 10 | get_hex }}",
    "outline_variant": "{{ colors.outline_variant.default | saturate: 10 | get_hex }}",
    "shadow": "{{ colors.shadow.default.hex }}",
    "scrim": "{{ colors.scrim.default.hex }}",
    "inverse_surface": "{{ colors.inverse_surface.default.hex }}",
    "inverse_primary": "{{ colors.inverse_primary.default | saturate: 25 | get_hex }}",
    "error": "{{ colors.error.default.hex }}",
    "on_error": "{{ colors.on_error.default.hex }}",
    "error_container": "{{ colors.error_container.default.hex }}",
    "on_error_container": "{{ colors.on_error_container.default.hex }}"
  },

  "term_ansi": {
    "black": "{{ colors.surface_container_lowest.default | saturate: 10 | get_hex }}",
    "red": "{{ colors.error.default.hex }}",
    "green": "{{ colors.tertiary.default | saturate: 30 | get_hex }}",
    "yellow": "{{ colors.secondary.default | saturate: 25 | get_hex }}",
    "blue": "{{ colors.primary.default | saturate: 30 | get_hex }}",
    "magenta": "{{ colors.inverse_primary.default | saturate: 25 | get_hex }}",
    "cyan": "{{ colors.tertiary_container.default | saturate: 30 | get_hex }}",
    "white": "{{ colors.on_surface.default.hex }}",

    "bright_black": "{{ colors.outline.default.hex }}",
    "bright_red": "{{ colors.error_container.default.hex }}",
    "bright_green": "{{ colors.tertiary_container.default | saturate: 25 | get_hex }}",
    "bright_yellow": "{{ colors.secondary_container.default | saturate: 20 | get_hex }}",
    "bright_blue": "{{ colors.primary_container.default | saturate: 25 | get_hex }}",
    "bright_magenta": "{{ colors.primary.default | saturate: 35 | get_hex }}",
    "bright_cyan": "{{ colors.outline_variant.default.hex }}",
    "bright_white": "{{ colors.on_surface_variant.default.hex }}"
